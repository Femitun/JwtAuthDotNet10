{
  "ConnectionStrings": {
    "DefaultConnection": "<YourConnectionString>"
  },
  "Jwt": {
    "Token": "<YourToken>",
    "Issuer": "<YourIssuer>",
    "Audience": "<YourAudience>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}